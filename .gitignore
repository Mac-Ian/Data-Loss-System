# ──────────────────────────────────────────────────────────────

# ── Python / Django ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/
ENV/

# Django
*.sqlite3
backend/.env
backend/staticfiles/
backend/media/
backend/logs/
db.sqlite3

# ── Node / React ──────────────────────────────────────────────
node_modules/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.production
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ────────────────────────────────────────────────────
.env                  # root .env used by docker-compose

# ── VS Code ───────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# ── Sensitive / generated ─────────────────────────────────────
*.pem
*.key
*.cert
*.log
celerybeat-schedule
celerybeat.pid
