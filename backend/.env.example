# backend/.env.example
# DLMS – Riba & Company Limited
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in YOUR real values (DB password, secret key, etc.)
#   3. NEVER commit .env to GitHub — it is in .gitignore
#
# Generate DJANGO_SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ──────────────────────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-50-character-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database
DB_NAME=dlms_db
DB_USER=dlms_user
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis (Celery broker + Django cache)
REDIS_URL=redis://127.0.0.1:6379/0

# Email (use console backend for development, SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=dlms@riba.ug

# Frontend URL (used in email alert links)
FRONTEND_URL=http://localhost:3000
